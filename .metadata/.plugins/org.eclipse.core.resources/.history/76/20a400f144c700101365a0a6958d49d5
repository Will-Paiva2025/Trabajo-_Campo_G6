package GUI;

import java.awt.EventQueue;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.*;
import java.awt.*;
import Clases.PanelInventario;
import javax.swing.JFrame;
import javax.swing.JPanel;
import javax.swing.border.EmptyBorder;

import Clases.PanelAgregar;
import Clases.PanelBuscarCodigo;
import Clases.PanelBuscarNombre;
import Clases.PanelEliminar;
import Clases.PanelInventario;
import Clases.PanelModificar;

public class MenuPrincipal extends JFrame {

	private static final long serialVersionUID = 1L;
	private JPanel contentPanel;

	
	public MenuPrincipal() {
		 setTitle("Sistema de Inventario - Bodega");
	        setSize(800, 600);
	        setLocationRelativeTo(null);
	        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
	        setResizable(false);

	        JTabbedPane tabs = new JTabbedPane();

	        // ------ Pestañas ------
	        btnVerInventario.addActionListener(new ActionListener() {
				
	        	@Override
	            public void actionPerformed(ActionEvent e) {

	                PanelInventario panelInventario = new PanelInventario();

	                tabMenu.addTab("Ver Inventario", panelInventario);

	                tabMenu.setSelectedComponent(panelInventario);
					
				}
			});	          
	        tabs.addTab("Agregar Producto", new PanelAgregar());
	        tabs.addTab("Modificar Producto", new PanelModificar());
	        tabs.addTab("Eliminar Producto", new PanelEliminar());
	        tabs.addTab("Buscar por Código", new PanelBuscarCodigo());
	        tabs.addTab("Buscar por Nombre", new PanelBuscarNombre());

	        getContentPane().add(tabs, BorderLayout.CENTER);
	}
	 public static void main(String[] args) {
	        SwingUtilities.invokeLater(() -> new MenuPrincipal().setVisible(true));
	    }
}
