package GUI;

import javax.swing.JPanel;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;

import Clases.DetalleBoleta;
import Clases.Producto;
import arrayList.ArrayBoleta;
import arrayList.ArrayMovimiento;
import arrayList.ArrayProducto;

import java.awt.*;
import java.util.ArrayList;

public class PanelBoleta extends JPanel {

    private String usuarioLogueado;
    private JTextField txtCliente, txtCodigo, txtCantidad;
    private JLabel lblTotal;
    private JTable tabla;
    private DefaultTableModel modelo;

    private ArrayProducto daoProd = new ArrayProducto();
    private ArrayBoleta daoBoleta = new ArrayBoleta();
    private ArrayMovimiento daoMov = new ArrayMovimiento();

    public PanelBoleta(String usuarioLogueado) {
        this.usuarioLogueado = usuarioLogueado;

        setLayout(new BorderLayout());

        // ---------- Panel superior ----------
        JPanel panelTop = new JPanel(new GridLayout(2, 1));

        JPanel fila1 = new JPanel(new FlowLayout(FlowLayout.LEFT));
        fila1.add(new JLabel("Cliente:"));
        txtCliente = new JTextField(20);
        fila1.add(txtCliente);

        JPanel fila2 = new JPanel(new FlowLayout(FlowLayout.LEFT));
        fila2.add(new JLabel("Código producto:"));
        txtCodigo = new JTextField(10);
        fila2.add(txtCodigo);
        
        JButton btnBuscarProd = new JButton("Buscar...");
        fila2.add(btnBuscarProd);

        fila2.add(new JLabel("Cantidad:"));
        txtCantidad = new JTextField(5);
        fila2.add(txtCantidad);

        JButton btnAgregar = new JButton("Agregar");
        fila2.add(btnAgregar);

        panelTop.add(fila1);
        panelTop.add(fila2);

        add(panelTop, BorderLayout.NORTH);

        // ---------- Tabla ----------
        modelo = new DefaultTableModel(
                new Object[]{"Código", "Nombre", "Precio", "Cantidad", "Subtotal"}, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false; // tabla solo lectura
            }
        };

        tabla = new JTable(modelo);
        tabla.setFillsViewportHeight(true);
        tabla.setAutoCreateRowSorter(true);

        add(new JScrollPane(tabla), BorderLayout.CENTER);

        // ---------- Panel inferior ----------
        JPanel panelBottom = new JPanel(new BorderLayout());

        JPanel panelBotones = new JPanel();
        JButton btnQuitar = new JButton("Quitar producto");
        JButton btnGenerar = new JButton("Generar boleta");
        panelBotones.add(btnQuitar);
        panelBotones.add(btnGenerar);

        JPanel panelTotal = new JPanel(new FlowLayout(FlowLayout.RIGHT));
        panelTotal.add(new JLabel("Total: S/ "));
        lblTotal = new JLabel("0.00");
        panelTotal.add(lblTotal);

        panelBottom.add(panelBotones, BorderLayout.WEST);
        panelBottom.add(panelTotal, BorderLayout.EAST);

        add(panelBottom, BorderLayout.SOUTH);

        // ---------- Eventos ----------
        btnAgregar.addActionListener(e -> agregarProducto());
        btnQuitar.addActionListener(e -> quitarProducto());
        btnGenerar.addActionListener(e -> generarBoleta());
        btnBuscarProd.addActionListener(e -> {
            Frame owner = (Frame) SwingUtilities.getWindowAncestor(this);
            DialogSeleccionProducto dlg = new DialogSeleccionProducto(owner);
            dlg.setVisible(true);
            Producto pSel = dlg.getProductoSeleccionado();
            if (pSel != null) {
                txtCodigo.setText(pSel.getCodi_prod());
                txtCantidad.requestFocus();
            }
        });
    }

    private void agregarProducto() {
        String cod = txtCodigo.getText().trim();
        String cantStr = txtCantidad.getText().trim();

        if (cod.isEmpty() || cantStr.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Ingrese código y cantidad");
            return;
        }

        int cantidad;
        try {
            cantidad = Integer.parseInt(cantStr);
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Cantidad no válida");
            return;
        }

        if (cantidad <= 0) {
            JOptionPane.showMessageDialog(this, "La cantidad debe ser mayor a 0");
            return;
        }

        // Buscar producto por código
        ArrayList<Producto> lista = daoProd.ConsultarCod(cod);
        if (lista.isEmpty()) {
            JOptionPane.showMessageDialog(this, "No existe un producto con código " + cod);
            return;
        }

        Producto p = lista.get(0);

        if (cantidad > p.getStock_prod()) {
            JOptionPane.showMessageDialog(this,
                    "Stock insuficiente. Stock actual: " + p.getStock_prod());
            return;
        }

        double subtotal = p.getPrecio_prod() * cantidad;

        modelo.addRow(new Object[]{
                p.getCodi_prod(),
                p.getNom_prod(),
                p.getPrecio_prod(),
                cantidad,
                subtotal
        });

        calcularTotal();

        txtCodigo.setText("");
        txtCantidad.setText("");
        txtCodigo.requestFocus();
    }

    private void quitarProducto() {
        int fila = tabla.getSelectedRow();
        if (fila < 0) {
            JOptionPane.showMessageDialog(this, "Seleccione un producto de la tabla");
            return;
        }
        modelo.removeRow(fila);
        calcularTotal();
    }

    private void calcularTotal() {
        double total = 0;
        for (int i = 0; i < modelo.getRowCount(); i++) {
            double sub = Double.parseDouble(modelo.getValueAt(i, 4).toString());
            total += sub;
        }
        lblTotal.setText(String.format("%.2f", total));
    }

    private void generarBoleta() {
        String cliente = txtCliente.getText().trim();
        if (cliente.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Ingrese el nombre del cliente");
            return;
        }

        if (modelo.getRowCount() == 0) {
            JOptionPane.showMessageDialog(this, "No hay productos en la boleta");
            return;
        }

        // Construir lista de detalles
        ArrayList<DetalleBoleta> detalles = new ArrayList<>();
        for (int i = 0; i < modelo.getRowCount(); i++) {
            String cod = modelo.getValueAt(i, 0).toString();
            String nom = modelo.getValueAt(i, 1).toString();
            double precio = Double.parseDouble(modelo.getValueAt(i, 2).toString());
            int cant = Integer.parseInt(modelo.getValueAt(i, 3).toString());
            detalles.add(new DetalleBoleta(cod, nom, precio, cant));
        }

        // Registrar boleta y descontar stock
        int idBoleta = daoBoleta.registrarBoleta(cliente, usuarioLogueado, detalles);

        if (idBoleta <= 0) {
            JOptionPane.showMessageDialog(this, "Error al registrar la boleta");
            return;
        }

        // Registrar movimientos en historial (acción VENTA)
        for (DetalleBoleta d : detalles) {
            ArrayList<Producto> lista = daoProd.ConsultarCod(d.getCodiProd());
            if (!lista.isEmpty()) {
                Producto prodActual = lista.get(0); // ya con stock descontado
                String razon = "VENTA - Boleta #" + idBoleta + " a " + cliente +
                               " - Cantidad vendida: " + d.getCantidad();
                daoMov.registrarMovimiento(usuarioLogueado, "VENTA", razon, prodActual);
            }
        }

        JOptionPane.showMessageDialog(this, "Boleta generada correctamente. N° " + idBoleta);

        // Limpiar pantalla
        modelo.setRowCount(0);
        calcularTotal();
        txtCliente.setText("");
        txtCodigo.setText("");
        txtCantidad.setText("");
    }
}